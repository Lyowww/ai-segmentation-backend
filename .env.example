# Required
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional
PORT=3001
OPENAI_MODEL=gpt-4.1
# Gemini model is hardcoded in src/config.js (gemini-2.5-flash;
# fallback: gemini-2.0-flash). Do not set GEMINI_MODEL / GEMINI_FALLBACK_MODELS.
GEMINI_MAX_RETRIES=3
GEMINI_RETRY_BASE_MS=1000
# Multipart is request-size bound, so keep it below platform caps.
MAX_MULTIPART_UPLOAD_BYTES=4194304
# Base64 expands by ~33%, so keep decoded image bytes below the JSON body limit.
MAX_BASE64_IMAGE_BYTES=3145728
# Remote URLs are fetched server-side, so they can safely allow larger originals.
MAX_REMOTE_IMAGE_BYTES=15728640
# Keep JSON under the platform request cap with a small buffer for metadata fields.
MAX_JSON_BODY_BYTES=4194304
# Reject extreme images before sharp does expensive work.
MAX_SOURCE_IMAGE_DIMENSION=8192
MAX_SOURCE_IMAGE_PIXELS=40000000
# Downscale very large accepted sources before endpoint-specific AI compression.
NORMALIZE_SOURCE_IMAGE_DIMENSION=2048
IMAGE_FETCH_TIMEOUT_MS=15000
