# Required
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional
PORT=3001
OPENAI_MODEL=gpt-4.1
GEMINI_MODEL=gemini-2.5-flash
# GEMINI_MODEL=gemini-2.5-pro
# GEMINI_MODEL=gemini-3-pro-preview
# Comma-separated fallbacks when the primary model is overloaded (429/503)
GEMINI_FALLBACK_MODELS=gemini-2.0-flash,gemini-2.5-pro
GEMINI_MAX_RETRIES=3
GEMINI_RETRY_BASE_MS=1000
# 2 MiB default on Vercel (4.5 MiB platform request cap); 15 MiB locally
MAX_UPLOAD_BYTES=2097152
IMAGE_FETCH_TIMEOUT_MS=15000
