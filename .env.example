# Required
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional
PORT=3001
CORS_ORIGIN=http://localhost:3000
# Comma-separated origins also work, e.g.:
# CORS_ORIGIN=https://your-app.vercel.app,http://localhost:3000
OPENAI_MODEL=gpt-4.1
GEMINI_MODEL=gemini-3-pro-preview
# Vercel serverless request body limit is ~4.5 MB; keep uploads under that in production.
MAX_UPLOAD_BYTES=4500000
